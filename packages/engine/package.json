{
  "name": "@agentx/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-migration-registry.mjs",
    "build": "tsup && node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('dist/data',{recursive:true});fs.copyFileSync('data/crew-catalog.manifest.json','dist/data/crew-catalog.manifest.json');fs.mkdirSync('dist/voice',{recursive:true});fs.copyFileSync(path.join('..','voice-sidecar','voice-models.manifest.json'),'dist/voice/voice-models.manifest.json');const copyDir=(s,d)=>{fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s,{withFileTypes:true})){const sp=path.join(s,e.name);const dp=path.join(d,e.name);if(e.isDirectory())copyDir(sp,dp);else fs.copyFileSync(sp,dp);}};copyDir('skills','dist/skills');\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentx/shared": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/azure": "^3.0.74",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/google": "^3.0.82",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/xai": "^3.0.95",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "1.0.2",
    "@napi-rs/keyring": "^1.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@slack/bolt": "^4.7.3",
    "@teng-lin/agent-fetch": "^0.1.6",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "ai": "^6.0.205",
    "discord.js": "^14.26.4",
    "docxtemplater": "^3.69.0",
    "esbuild": "0.27.7",
    "exceljs": "^4.4.0",
    "file-type": "^19.6.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "httpcloak": "1.6.8",
    "imap": "^0.8.19",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.9",
    "mammoth": "^1.9.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.50.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.21.0",
    "pg-boss": "^10.1.5",
    "pizzip": "^3.2.0",
    "qrcode": "1.5.4",
    "trafilatura": "^0.2.0",
    "whatsapp-web.js": "1.34.7",
    "ws": "^8.17.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.0"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "devDependencies": {
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "1.5.5",
    "@types/ws": "^8.5.12",
    "@types/xml2js": "^0.4.14",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0",
    "redis": "^6.1.0"
  }
}
