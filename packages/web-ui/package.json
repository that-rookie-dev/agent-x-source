{
  "name": "@agentx/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm run build:observability",
    "build:observability": "vite build --outDir dist/observability -- rollupOptions.input observability.html",
    "dev:observability": "vite --config vite.config.ts observability.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentx/shared": "workspace:*",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@tabler/icons-react": "^3.44.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "jspdf": "^2.5.2",
    "marked": "^18.0.7",
    "mermaid": "^11.4.0",
    "pdfjs-dist": "^6.0.227",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.16.0",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.0",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
